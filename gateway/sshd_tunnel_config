# /etc/ssh/sshd_tunnel_config
# 隧道专用 sshd 实例。只服务 tunnel-* 账号，只允许建立一个指定端口的反向端口。
# 反向端口绑 0.0.0.0，公网可达；收回内网网卡或限定来源网段见方案 7.3。
# systemd: sshd-tunnel.service
ListenAddress 127.0.0.1:2222
HostKey /etc/ssh/tunnel_host_ed25519_key
PidFile /run/sshd-tunnel.pid
Subsystem sftp /bin/false

UsePAM yes
AuthenticationMethods password
PasswordAuthentication yes
PubkeyAuthentication no
PermitRootLogin no
AllowUsers tunnel-*

# 实测（见 gateway/tests/test_zombie_port.py 与 Task 6 报告）：这两行让 sshd
# 放弃一个静默失联的客户端、回收其反向端口，实际耗时约 80 秒，不是按
# ClientAliveInterval × ClientAliveCountMax = 30 秒算出来的那个数——机制细节与
# 测量方法见 docs/方案设计.md §4.2，这里只记为什么两个数值保持不变。
#
# 把 ClientAliveInterval 调小到 4 左右能把回收时间压到接近 30 秒，但代价是
# sshd 也会在约 32 秒的静默后就判定客户端已死并断开隧道——而客户端的静默不一定
# 是掉线：现场网络里 AP 漫游、VPN 重新协商、上行拥塞都会让链路安静几十秒，
# 期间远程工程师可能正通过这条隧道操作一体机。断开隧道会中断这次维护会话，
# 这比让现场人员在笔记本唤醒后多等几十秒更糟：多等是不便，维护中途被打断是
# 客服工单。因此不调这两个值；由此产生的约 80 秒回收时间，靠加大
# RECLAIM_BUDGET（见 test_zombie_port.py）来适配，而不是反过来压缩这两行。
ClientAliveInterval 10
ClientAliveCountMax 3
LoginGraceTime 20
MaxAuthTries 3

GatewayPorts yes
AllowTcpForwarding remote
PermitOpen none
PermitTTY no
X11Forwarding no
AllowAgentForwarding no
AllowStreamLocalForwarding no
ForceCommand /bin/false

# 全局默认拒绝一切反向端口，逐账号的 Match 块才是唯一放行的地方（见下面受管区
# 段里的 PermitListen <port>，Match 块里的值覆盖这里的全局值）。
# 没有这一行，一个还没写进受管区段的 tunnel-* 账号（例如登记表加了账号但
# scripts/enroll-account.sh 还没跑）就会落到 PermitListen 的出厂默认「任意端口」
# 上——在 GatewayPorts yes 之下那是任意端口绑 0.0.0.0，公网可达。客户接受的是
# 「一个账号一个端口公网可达」，不是「任意端口」，所以漏登记必须退化成「什么都
# 转不了」，而不是退化成敞开。
PermitListen none

# 以下 Match 块由 scripts/enroll-account.sh 依 registry.toml 生成，勿手工编辑。
# PermitListen 必须写成不带地址的裸端口形式。两条理由都在这套 OpenSSH（9.2p1）
# 上实测过：
# 一、带地址的形式（<地址>:<端口>）只认客户端请求里的那个字面地址，不做解析也
#     不做模式匹配。现场的命令 `ssh -R 22001:127.0.0.1:61001 ...` 不写监听地址，
#     客户端据此请求的监听地址是 "localhost"，与放行项 `127.0.0.1:22001` 字面不
#     相等，服务端直接拒掉并记录 "to remote forward to host localhost port 22001,
#     but the request was denied"。
# 二、GatewayPorts yes 之下实际绑在哪个地址上完全由服务端决定（恒为通配），客户端
#     请求里的地址不影响绑定结果——实测带地址的放行项配上 `-R 127.0.0.1:22001:...`
#     也照样绑到 0.0.0.0/[::]。所以在 PermitListen 里限制地址一分安全都不买，只会
#     挡掉合法客户端。
# 地址因此不受限制，端口仍然逐账号只放行一个。
# BEGIN RMC MANAGED
Match User tunnel-zhang
    PermitListen 22001
# END RMC MANAGED
